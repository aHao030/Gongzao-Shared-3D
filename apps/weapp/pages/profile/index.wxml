<view class="page profile-form">
  <view class="eyebrow">ACCOUNT</view><view class="title">完善账号资料。</view>
  <view wx:if="{{isLocal}}" class="card"><view class="section-title">本机演示无需填写地址</view><view class="muted">本模式不采集或保存真实收货信息。小程序服务端鉴权尚未接通，完成受支持的登录接入后才能保存账号资料。</view><button class="secondary" bindtap="goBack">返回定制</button></view>
  <block wx:else>
    <view class="demo-note">地址仅发送给已配置的服务端沙盒，用于配送费用测算。修改地址后需重新报价，不会修改已创建订单的收货地址。</view>
    <view wx:if="{{loading}}" class="card muted">正在读取账号资料与国家配置…</view>
    <view wx:if="{{error}}" class="card danger">{{error}}<button wx:if="{{!marketsReady && !loading}}" class="secondary" bindtap="onShow">重新读取</button></view>
    <view wx:if="{{!loading && marketsReady}}" class="card">
      <view class="label">昵称（选填）</view><input class="field" value="{{form.displayName}}" data-field="displayName" bindinput="changeField" maxlength="80" disabled="{{saving}}" />
      <view class="label">国家或地区 <text class="required">*</text></view>
      <picker range="{{countryOptions}}" range-key="name" value="{{countryIndex}}" bindchange="changeCountry" disabled="{{saving}}"><view class="field country-picker">{{countryOptions[countryIndex].name}}<text class="picker-arrow">⌄</text></view></picker>
      <block wx:if="{{otherCountry}}"><view class="label">实际国家或地区代码 <text class="required">*</text></view><input class="field" value="{{form.countryCode}}" data-field="countryCode" bindinput="changeField" maxlength="2" placeholder="两位英文字母，例如 BR" disabled="{{saving}}" /></block>
      <block wx:for="{{addressFields}}" wx:key="key">
        <view class="label">{{item.label}} <text wx:if="{{item.required}}" class="required">*</text><text wx:if="{{item.showOptional}}" class="optional">（选填）</text></view>
        <textarea wx:if="{{item.key === 'addressLine'}}" class="field" value="{{form[item.key]}}" data-field="{{item.key}}" bindinput="changeField" maxlength="{{item.maxlength}}" placeholder="{{item.placeholder}}" disabled="{{saving}}" />
        <input wx:else class="field" value="{{form[item.key]}}" data-field="{{item.key}}" bindinput="changeField" maxlength="{{item.maxlength}}" placeholder="{{item.placeholder}}" disabled="{{saving}}" />
        <view wx:if="{{item.key === 'phone'}}" class="muted phone-hint">{{item.placeholder}}</view>
      </block>
      <view class="muted address-note">{{addressNote}}</view>
      <view class="payment-panel"><view class="section-title">付款方式 · 待接入</view><view class="muted currency-note">{{currencyNote}}</view><view class="payment-methods"><view wx:for="{{paymentMethods}}" wx:key="id" class="payment-method">{{item.label}}<text class="method-state">待开通</text></view></view><view class="muted payment-note">{{paymentNote}}</view></view>
      <button class="primary" bindtap="saveProfile" disabled="{{saving}}">{{saving ? '正在保存…' : '保存并测算费用'}}</button><button class="ghost" bindtap="goBack" disabled="{{saving}}">稍后填写</button>
    </view>
  </block>
</view>
