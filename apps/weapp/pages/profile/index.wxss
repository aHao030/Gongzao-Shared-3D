.profile-form textarea{width:100%;height:160rpx}.profile-form .field{color:#1d1d1f;background:#fafafa;border-color:#dedede}.profile-form .primary{background:#1d1d1f}.profile-form .label{color:#555}.profile-form .muted{color:#777}
.profile-form .phone-hint{font-size:22rpx;line-height:1.6;margin:8rpx 0 20rpx}
.profile-form .country-picker{display:flex;align-items:center;justify-content:space-between}.profile-form .picker-arrow{color:#777;font-size:30rpx}.profile-form .optional{font-size:22rpx;color:#999}.profile-form .required{color:#333}.profile-form .address-note{margin:24rpx 0;font-size:24rpx;line-height:1.7}.profile-form .payment-panel{border-top:1rpx solid #e5e5e5;margin-top:36rpx;padding-top:30rpx}.profile-form .currency-note,.profile-form .payment-note{font-size:23rpx;line-height:1.7;margin:16rpx 0}.profile-form .payment-methods{display:flex;flex-wrap:wrap;gap:12rpx}.profile-form .payment-method{padding:12rpx 16rpx;border:1rpx solid #e5e5e5;border-radius:12rpx;font-size:23rpx;color:#555}.profile-form .method-state{margin-left:12rpx;font-size:21rpx;color:#999}
