page{background:#f5f7f3;color:#173b36;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6;box-sizing:border-box}view,button,input{box-sizing:border-box}.page{padding:36rpx 30rpx 64rpx}.eyebrow{color:#087f73;font-size:21rpx;letter-spacing:4rpx;font-weight:600}.title{font-size:52rpx;font-weight:700;line-height:1.24;margin:12rpx 0 16rpx}.subtitle{color:#657d76;font-size:26rpx}.demo-note{background:#e5f2ed;color:#286356;border:1rpx solid #c7e3d7;border-radius:18rpx;padding:20rpx 24rpx;margin:26rpx 0;font-size:23rpx}.card{background:#fff;border:1rpx solid #e1e9e2;border-radius:28rpx;padding:28rpx;margin:22rpx 0}.section-title{font-size:31rpx;font-weight:650}.muted{color:#71867f;font-size:24rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.divider{height:1rpx;background:#e7ede8;margin:22rpx 0}.label{color:#617c73;font-size:24rpx;margin-bottom:10rpx}.field{background:#f4f7f3;border:1rpx solid #dfe8df;border-radius:16rpx;padding:20rpx 22rpx;margin:10rpx 0 24rpx;min-height:80rpx;font-size:28rpx}.primary{background:#087f73;color:#fff;border-radius:18rpx;font-size:28rpx;font-weight:600;padding:2rpx 12rpx;margin:20rpx 0}.secondary{background:#e8f3ed;color:#176453;border-radius:18rpx;font-size:27rpx;margin:18rpx 0}.ghost{background:transparent;color:#627d73;font-size:24rpx;margin:18rpx 0}button::after{border:0}.price{font-size:48rpx;font-weight:700;color:#087f73;line-height:1.2}.badge{display:inline-block;font-size:21rpx;padding:5rpx 15rpx;border-radius:99rpx;color:#087f73;background:#e4f3eb}.empty{text-align:center;padding:70rpx 22rpx}.empty-title{font-size:34rpx;font-weight:650;margin-bottom:16rpx}.space{height:14rpx}.step{padding:15rpx 0 15rpx 24rpx;margin-left:6rpx;border-left:4rpx solid #e1eae3;color:#819187;font-size:25rpx}.step.active{border-color:#0d8b78;color:#0d755f;font-weight:650}.step-number{display:inline-block;width:40rpx;font-size:23rpx}.small{font-size:22rpx}.model-icon{font-size:64rpx;color:#087f73}.card-foot{margin-top:18rpx;color:#678077;font-size:23rpx}.danger{color:#8b6258}
