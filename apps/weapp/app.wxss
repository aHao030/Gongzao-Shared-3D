page{background:#f5f5f7;color:#1d1d1f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6;box-sizing:border-box}view,button,input{box-sizing:border-box}.page{padding:36rpx 30rpx 64rpx}.eyebrow{color:#1d1d1f;font-size:21rpx;letter-spacing:4rpx;font-weight:600}.title{font-size:52rpx;font-weight:700;line-height:1.24;margin:12rpx 0 16rpx}.subtitle{color:#57575a;font-size:26rpx}.demo-note{background:#eeeeef;color:#424245;border:1rpx solid #d2d2d7;border-radius:18rpx;padding:20rpx 24rpx;margin:26rpx 0;font-size:23rpx}.card{background:#fff;border:1rpx solid #dedee1;border-radius:28rpx;padding:28rpx;margin:22rpx 0}.section-title{font-size:31rpx;font-weight:650}.muted{color:#626265;font-size:24rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.divider{height:1rpx;background:#e5e5e7;margin:22rpx 0}.label{color:#515154;font-size:24rpx;margin-bottom:10rpx}.field{background:#fafafa;border:1rpx solid #ceced2;border-radius:16rpx;padding:20rpx 22rpx;margin:10rpx 0 24rpx;min-height:80rpx;font-size:28rpx}.primary{background:#1d1d1f;color:#fff;border-radius:18rpx;font-size:28rpx;font-weight:600;padding:2rpx 12rpx;margin:20rpx 0}.secondary{background:#ededee;color:#29292b;border-radius:18rpx;font-size:27rpx;margin:18rpx 0}.ghost{background:transparent;color:#424245;font-size:24rpx;margin:18rpx 0}button::after{border:0}.price{font-size:48rpx;font-weight:700;color:#1d1d1f;line-height:1.2}.badge{display:inline-block;font-size:21rpx;padding:5rpx 15rpx;border-radius:99rpx;color:#1d1d1f;background:#ededee}.empty{text-align:center;padding:70rpx 22rpx}.empty-title{font-size:34rpx;font-weight:650;margin-bottom:16rpx}.space{height:14rpx}.step{padding:15rpx 0 15rpx 24rpx;margin-left:6rpx;border-left:4rpx solid #d2d2d7;color:#636366;font-size:25rpx}.step.active{border-color:#1d1d1f;color:#29292b;font-weight:650}.step-number{display:inline-block;width:40rpx;font-size:23rpx}.small{font-size:22rpx}.model-icon{font-size:64rpx;color:#1d1d1f}.card-foot{margin-top:18rpx;color:#56565a;font-size:23rpx}.danger{color:#353537;font-weight:650}
