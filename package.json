{
  "name": "gongzao-shared-fabrication",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "description": "共造共享制造平台：模型询价、制造运算、生产库存与履约沙盒",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node services/platform/local.mjs",
    "test": "node --test tests/*.test.mjs apps/tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "api:demo": "node services/api/server.mjs",
    "dev": "node services/platform/local.mjs",
    "build": "node tools/build-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "test:load": "node tools/load-smoke.mjs",
    "gateway": "node services/device-gateway/cli.mjs",
    "worker:configure": "node tools/create-worker-config.mjs",
    "worker": "node services/manufacturing-worker/cli.mjs",
    "integrations": "node services/integrations/cli.mjs",
    "identity:configure": "node services/identity/setup.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2"
  }
}
